# FastAPI Task Manager API 环境变量配置
# 复制此文件为 .env 并修改相应值

# 应用配置
APP_NAME=Task Manager API
APP_ENV=development

# API 配置
API_TITLE=Task Manager API
APP_DESCRIPTION=FastAPI任务管理API

# JWT 配置（生产环境必须更换！）
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./taskmanager.db
